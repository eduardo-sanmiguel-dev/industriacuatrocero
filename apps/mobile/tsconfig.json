{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "@synergy/types": ["../../packages/types"]
    }
  },
  // 🚀 INCLUSIÓN FORMAL: Mapea tu global.d.ts y los archivos TypeScript nativos de Expo
  "include": [
    "global.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // 🛡️ BLINDAJE ANTICONTAMINACIÓN: Evita que el typecheck de Expo analice código exclusivo de la web
  "exclude": [
    "node_modules",
    "src/**/*.web.tsx",
    "src/**/*.web.ts",
    "src/**/*.css",
    "**/*.module.css"
  ]
}
